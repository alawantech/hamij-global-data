{
  "expo": {
    "name": "Hamij Global Data",
    "slug": "hamij-global-data",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hamijglobaldata.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hamijglobaldata.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "softwareKeyboardSoftInputMode": "adjustResize"
    },
    "privacyPolicy": "https://hamijglobaldata.com/privacy",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-contacts"
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-sharing",
      "expo-status-bar",
      "./plugins/withStartupSplash.js"
    ],
    "extra": {
      "eas": {
        "projectId": "TBD"
      }
    }
  }
}
